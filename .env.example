# Public configuration only. Never put private RPC credentials in VITE_*.
# Leave disabled until a same-origin HTTPS TTL service is actually deployed.
VITE_WALLET_AUTH_ENABLED=false
# Fill only with the actual deployed program address after local tests pass.
VITE_SOLANA_PROGRAM_ID=
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Operator-only public build identity, derived from the actual program keypair.
CERTICHAIN_PROGRAM_ID=